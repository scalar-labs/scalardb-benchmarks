#scalar.db.transaction_manager=single-crud-operation
scalar.db.consensus_commit.one_phase_commit.enabled=false
scalar.db.consensus_commit.parallel_preparation.enabled=true
scalar.db.consensus_commit.parallel_validation.enabled=true
scalar.db.consensus_commit.parallel_commit.enabled=true
scalar.db.consensus_commit.parallel_rollback.enabled=true
scalar.db.consensus_commit.async_commit.enabled=true
scalar.db.consensus_commit.async_rollback.enabled=true
scalar.db.consensus_commit.isolation_level=SNAPSHOT

scalar.db.storage=jdbc
scalar.db.contact_points=jdbc:postgresql://aup-postgres1.postgres.database.azure.com:5432/postgres
scalar.db.jdbc.isolation_level=REPEATABLE_READ
scalar.db.username=hiroyuki
scalar.db.password=Postgres18
scalar.db.jdbc.connection_pool.min_idle=50
scalar.db.jdbc.connection_pool.max_idle=100
scalar.db.jdbc.connection_pool.max_total=250
